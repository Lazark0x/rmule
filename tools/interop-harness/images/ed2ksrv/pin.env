# The ed2ksrv coordinator's pin of record: the one place it is written.
# `build.sh` verifies the source clone against it and stamps it on the image as
# `org.rmule.ed2ksrv.*` labels; the harness compiles this file in, refuses to
# start an image whose commit label does not match it, and names the pin in
# every verdict's `Body.pin` (unverified only on a deliberate
# RMULE_BENCH_ED2KSRV_OFF_PIN=1 run). The SHA is upstream's `v0.9.75^{}`
# (`git ls-remote https://github.com/andrey23127/ed2k-server`, read 2026-09-25).
ED2KSRV_REPO=andrey23127/ed2k-server
ED2KSRV_COMMIT=4da4774fa8f61f5c1e40ac5054494502c5d75e6d
ED2KSRV_VERSION=v0.9.75
